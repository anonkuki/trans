# Shared private service authentication (set the same strong value on both services)
PDF_ENGINE_INTERNAL_TOKEN=replace-with-a-long-random-value
PDF_ENGINE_OCR_PROVIDER=paddle
PDF_ENGINE_WORK_ROOT=D:/Temp/trans-document-engine
PDF_ENGINE_MAX_UPLOAD_MB=50
# PaddleOCR-VL credentials stay in the document engine only
RETAIN_PADDLE_TOKEN=replace-with-paddle-token
RETAIN_PADDLE_API_URL=
RETAIN_PADDLE_MODEL=PaddleOCR-VL-1.6

# System 1 -> document engine
SPRING_PROFILES_ACTIVE=local
TRANSDOC_PDF_CONVERT_MODE=1
TRANSDOC_PYTHON_RECOGNIZE_URL=http://127.0.0.1:8030/internal/v1/ocr/recognize
TRANSDOC_PYTHON_INTERNAL_TOKEN=replace-with-the-same-random-value
TRANSDOC_PYTHON_CONNECT_TIMEOUT=10s
TRANSDOC_PYTHON_READ_TIMEOUT=31m
TRANSDOC_PYTHON_FALLBACK_ENABLED=false
TRANSDOC_TEMP_DIR=D:/Temp/trans-platform
TRANSDOC_MAX_FILE_SIZE=50MB
TRANSDOC_MAX_REQUEST_SIZE=55MB

# System 1 translation model. The key is never sent to the document engine or browser.
QWEN_API_KEY=replace-with-qwen-key
QWEN_MODEL=qwen3.8-flash

# Shared placeholders used by the delivered System 1 application profiles.
SVA_CONFIG_PASSWORD=replace-with-local-infrastructure-password
SVA_CONFIG_SECRET=replace-with-service-secret
XXL_JOB_ACCESS_TOKEN=replace-with-job-executor-token
DIFY_API_KEY=replace-with-dify-api-key

# Optional System 1 social-login credentials; keep them server-side.
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
WECOM_CLIENT_ID=
WECOM_CLIENT_SECRET=
WECOM_AGENT_ID=
WECHAT_MINIAPP_SECRET=
WECHAT_MP_SECRET=
